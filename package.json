{
  "name": "@craftzdog/fs-plus",
  "version": "4.0.4",
  "description": "node's fs with more helpers",
  "keywords": [
    "filesystem",
    "fs"
  ],
  "homepage": "https://github.com/craftzdog/fs-plus",
  "bugs": {
    "url": "https://github.com/craftzdog/fs-plus/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftzdog/fs-plus.git"
  },
  "type": "module",
  "main": "./lib/fs-plus.mjs",
  "types": "./lib/fs-plus.d.mts",
  "exports": {
    ".": {
      "types": "./lib/fs-plus.d.mts",
      "default": "./lib/fs-plus.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "temp": "^0.9.4",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
